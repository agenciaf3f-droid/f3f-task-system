// F3F Task System — Database schema
// https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  admin
  manager
  supervisor
  member
}

enum CompanyPlan {
  free
  pro
  enterprise
}

enum TaskStatus {
  todo
  in_progress
  review
  blocked
  done
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum ProjectStatus {
  active
  completed
  paused
  archived
  cancelled
}

enum BroadcastStatus {
  draft
  scheduled
  sending
  completed
  canceled
  failed
}

enum BroadcastMessageType {
  text
  image
  video
  audio
  poll
}

// ============================================================
// CORE TENANT
// ============================================================

model Company {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @db.VarChar(255)
  slug      String      @unique @db.VarChar(100)
  logoUrl   String?     @map("logo_url")
  plan      CompanyPlan @default(free)
  settings  Json        @default("{}")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  deletedAt DateTime?   @map("deleted_at")

  users             User[]
  sectors           Sector[]
  tasks             Task[]
  templates         Template[]
  activityLogs      ActivityLog[]
  permissions       Permission[]
  clients           Client[]
  projects          Project[]
  webhookConfig     WebhookConfig?
  bookingMagicLinks BookingMagicLink[]
  broadcasts        Broadcast[]

  @@map("companies")
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  name               String    @db.VarChar(255)
  email              String    @unique @db.VarChar(255)
  passwordHash       String    @map("password_hash")
  avatarUrl          String?   @map("avatar_url")
  role               UserRole  @default(member)
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  company                 Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  managedSectors          Sector[]               @relation("SectorManager")
  sectorMemberships       SectorMember[]
  assignedTasks           Task[]                 @relation("TaskAssignee")
  taskAssignments         TaskAssignee[]         @relation("TaskAssignees")
  taskAssignmentsGiven    TaskAssignee[]         @relation("TaskAssigneeAssignedBy")
  createdTasks            Task[]                 @relation("TaskCreatedBy")
  watchedTasks            TaskWatcher[]
  checklistDone           TaskChecklistItem[]    @relation("ChecklistDoneBy")
  comments                TaskComment[]
  attachments             TaskAttachment[]
  templates               Template[]
  templateTargets         TemplateUser[]
  templateTaskAssignments TemplateTask[]         @relation("TemplateTaskAssignee")
  activityLogs            ActivityLog[]
  permissions             Permission[]
  projects                Project[]
  managedClients          Client[]               @relation("ClientManager")
  passwordResetTokens     PasswordResetToken[]
  calendarToken           String?                @unique @map("calendar_token") @db.VarChar(32)
  calendarSlug            String?                @unique @map("calendar_slug") @db.VarChar(60)
  googleCalendarId        String?                @unique @map("google_calendar_id") @db.VarChar(255)
  calendarAvailability    CalendarAvailability[]
  meetings                Meeting[]
  meetingAudience         MeetingAudience[]
  managedBookingLinks     BookingMagicLink[]     @relation("BookingMagicLinkManager")
  createdBroadcasts       Broadcast[]            @relation("BroadcastCreatedBy")
  createdBookingLinks     BookingMagicLink[]     @relation("BookingMagicLinkCreator")

  @@index([companyId])
  @@index([email])
  @@map("users")
}

// ============================================================
// SECTORS / DEPARTMENTS
// ============================================================

model Sector {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String    @db.VarChar(255)
  description String?
  color       String?   @db.VarChar(7)
  managerId   String?   @map("manager_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager         User?            @relation("SectorManager", fields: [managerId], references: [id], onDelete: SetNull)
  members         SectorMember[]
  tasks           Task[]
  templates       Template[]
  templateTargets TemplateSector[]

  @@index([companyId])
  @@map("sectors")
}

model SectorMember {
  sectorId  String   @map("sector_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sectorId, userId])
  @@map("sector_members")
}

// ============================================================
// TASKS
// ============================================================

model Task {
  id                 String       @id @default(uuid()) @db.Uuid
  companyId          String       @map("company_id") @db.Uuid
  sectorId           String?      @map("sector_id") @db.Uuid
  clientId           String?      @map("client_id") @db.Uuid
  projectId          String?      @map("project_id") @db.Uuid
  templateId         String?      @map("template_id") @db.Uuid
  parentTaskId       String?      @map("parent_task_id") @db.Uuid
  recurrenceRule     Json?        @map("recurrence_rule")
  recurrenceParentId String?      @map("recurrence_parent_id") @db.Uuid
  title              String       @db.VarChar(500)
  description        String?
  status             TaskStatus   @default(todo)
  isBlocked          Boolean      @default(false) @map("is_blocked")
  priority           TaskPriority @default(medium)
  progress           Int          @default(0)
  assigneeId         String?      @map("assignee_id") @db.Uuid
  createdById        String       @map("created_by") @db.Uuid
  dueDate            DateTime?    @map("due_date")
  completedAt        DateTime?    @map("completed_at")
  tags               String[]     @default([])
  metadata           Json         @default("{}")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")
  archivedAt         DateTime?    @map("archived_at")

  company               Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sector                Sector?             @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  client                Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project               Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  template              Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  parentTask            Task?               @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks              Task[]              @relation("TaskSubtasks")
  recurrenceParent      Task?               @relation("TaskRecurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceOccurrences Task[]              @relation("TaskRecurrence")
  assignee              User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy             User                @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignees             TaskAssignee[]
  blockedBy             TaskDependency[]    @relation("BlockedTask")
  blocking              TaskDependency[]    @relation("BlockingTask")
  watchers              TaskWatcher[]
  checklistItems        TaskChecklistItem[]
  comments              TaskComment[]
  attachments           TaskAttachment[]

  @@index([companyId])
  @@index([assigneeId])
  @@index([sectorId])
  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@index([templateId])
  @@index([companyId, assigneeId, deletedAt])
  @@index([companyId, status, dueDate])
  @@index([companyId, completedAt])
  @@index([createdById])
  @@index([recurrenceParentId])
  @@index([parentTaskId])
  @@map("tasks")
}

model TaskAssignee {
  taskId       String   @map("task_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedById String   @map("assigned_by_id") @db.Uuid

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User @relation("TaskAssignees", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User @relation("TaskAssigneeAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_assignees")
}

model TaskDependency {
  taskId       String   @map("task_id") @db.Uuid
  blocksTaskId String   @map("blocks_task_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  task       Task @relation("BlockingTask", fields: [taskId], references: [id], onDelete: Cascade)
  blocksTask Task @relation("BlockedTask", fields: [blocksTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, blocksTaskId])
  @@index([taskId])
  @@index([blocksTaskId])
  @@map("task_dependencies")
}

model TaskWatcher {
  taskId    String   @map("task_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_watchers")
}

model TaskChecklistItem {
  id       String    @id @default(uuid()) @db.Uuid
  taskId   String    @map("task_id") @db.Uuid
  title    String    @db.VarChar(500)
  isDone   Boolean   @default(false) @map("is_done")
  position Int       @default(0)
  doneAt   DateTime? @map("done_at")
  doneById String?   @map("done_by") @db.Uuid

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  doneBy User? @relation("ChecklistDoneBy", fields: [doneById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("task_checklist_items")
}

model TaskComment {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  content   String
  isEdited  Boolean   @default(false) @map("is_edited")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

model TaskAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  fileName  String   @map("file_name") @db.VarChar(255)
  fileUrl   String   @map("file_url")
  fileSize  Int      @map("file_size")
  mimeType  String   @map("mime_type") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachments")
}

// ============================================================
// CLIENTS & PROJECTS
// ============================================================

model Client {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  managerId         String?   @map("manager_id") @db.Uuid
  name              String    @db.VarChar(255)
  color             String?   @db.VarChar(7)
  email             String?   @db.VarChar(255)
  phone             String?   @db.VarChar(50)
  meetingPlan       String?   @map("meeting_plan") @db.VarChar(100)
  sourceGroupId     String?   @map("source_group_id") @db.VarChar(255)
  whatsappGroupId   String?   @map("whatsapp_group_id") @db.VarChar(255)
  whatsappGroupName String?   @map("whatsapp_group_name") @db.VarChar(255)
  externalId        String?   @map("external_id") @db.VarChar(50)
  avatarUrl         String?   @map("avatar_url")
  description       String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager             User?                @relation("ClientManager", fields: [managerId], references: [id], onDelete: SetNull)
  projects            Project[]
  tasks               Task[]
  bookingMagicLinks   BookingMagicLink[]
  broadcastRecipients BroadcastRecipient[]

  @@unique([companyId, whatsappGroupId])
  @@unique([companyId, sourceGroupId])
  @@index([companyId])
  @@index([managerId])
  @@index([companyId, externalId])
  @@map("clients")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  clientId    String        @map("client_id") @db.Uuid
  createdById String        @map("created_by") @db.Uuid
  name        String        @db.VarChar(255)
  description String?
  status      ProjectStatus @default(active)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  tasks     Task[]

  @@index([companyId])
  @@index([clientId])
  @@index([createdById])
  @@map("projects")
}

// ============================================================
// TEMPLATES (core differentiator)
// ============================================================

model Template {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  sectorId    String?   @map("sector_id") @db.Uuid
  createdById String    @map("created_by") @db.Uuid
  name        String    @db.VarChar(255)
  description String?
  category    String?   @db.VarChar(100)
  isPersonal  Boolean   @default(false) @map("is_personal")
  isActive    Boolean   @default(true) @map("is_active")
  useCount    Int       @default(0) @map("use_count")
  position    Int       @default(0)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sector        Sector?          @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  createdBy     User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  templateTasks TemplateTask[]
  targetSectors TemplateSector[]
  targetUsers   TemplateUser[]
  tasks         Task[]

  @@index([companyId])
  @@index([sectorId])
  @@index([companyId, isPersonal, createdById])
  @@map("templates")
}

model TemplateUser {
  templateId String @map("template_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([templateId, userId])
  @@index([userId])
  @@map("template_users")
}

model TemplateSector {
  templateId String @map("template_id") @db.Uuid
  sectorId   String @map("sector_id") @db.Uuid

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sector   Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([templateId, sectorId])
  @@index([sectorId])
  @@map("template_sectors")
}

model TemplateTask {
  id                  String       @id @default(uuid()) @db.Uuid
  templateId          String       @map("template_id") @db.Uuid
  title               String       @db.VarChar(500)
  description         String?
  priority            TaskPriority @default(medium)
  position            Int          @default(0)
  daysToComplete      Int?         @map("days_to_complete")
  defaultAssigneeRole UserRole?    @map("default_assignee_role")
  defaultAssigneeId   String?      @map("default_assignee_id") @db.Uuid

  template        Template                @relation(fields: [templateId], references: [id], onDelete: Cascade)
  defaultAssignee User?                   @relation("TemplateTaskAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  checklistItems  TemplateChecklistItem[]

  @@index([templateId])
  @@map("template_tasks")
}

model TemplateChecklistItem {
  id             String @id @default(uuid()) @db.Uuid
  templateTaskId String @map("template_task_id") @db.Uuid
  title          String @db.VarChar(500)
  position       Int    @default(0)

  templateTask TemplateTask @relation(fields: [templateTaskId], references: [id], onDelete: Cascade)

  @@index([templateTaskId])
  @@map("template_checklist_items")
}

// ============================================================
// AUDIT
// ============================================================

model ActivityLog {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   String?  @map("resource_id") @db.Uuid
  oldValue     Json?    @map("old_value")
  newValue     Json?    @map("new_value")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  createdAt    DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId])
  @@index([companyId, createdAt])
  @@index([userId])
  @@map("activity_logs")
}

// ============================================================
// WEBHOOK CONFIG
// ============================================================

model WebhookConfig {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @unique @map("company_id") @db.Uuid
  url       String
  secret    String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("webhook_configs")
}

// ============================================================
// PASSWORD RESET
// ============================================================

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================
// PERMISSIONS (fine-grained overrides)
// ============================================================

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  resource  String   @db.VarChar(100)
  action    String   @db.VarChar(50)
  isAllowed Boolean  @map("is_allowed")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, action])
  @@index([companyId])
  @@map("permissions")
}

// ============================================================
// CALENDAR
// ============================================================

model CalendarAvailability {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week") // 0=Dom, 1=Seg, ..., 6=Sáb
  startTime String   @map("start_time") @db.VarChar(5) // "09:00"
  endTime   String   @map("end_time") @db.VarChar(5) // "18:00"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
  @@index([userId])
  @@map("calendar_availability")
}

model Meeting {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  date          String   @db.VarChar(10) // "YYYY-MM-DD"
  endDate       String?  @map("end_date") @db.VarChar(10) // "YYYY-MM-DD"; null = mesmo dia (legado)
  startTime     String   @map("start_time") @db.VarChar(5) // "09:00"
  endTime       String   @map("end_time") @db.VarChar(5) // "09:30"
  isAllDay      Boolean  @default(false) @map("is_all_day")
  guestEmails   String[] @default([]) @map("guest_emails")
  status        String   @default("confirmed") @db.VarChar(20)
  googleEventId String?  @map("google_event_id")
  bookedAt      DateTime @default(now()) @map("booked_at")

  // Client data (from external DB)
  clientName    String? @map("client_name")
  clientGroupId String? @map("client_group_id")
  clientPlan    String? @map("client_plan")

  // Recurrence (booker-side fixed monthly)
  recurrenceRule     Json?   @map("recurrence_rule")
  recurrenceParentId String? @map("recurrence_parent_id") @db.Uuid

  // Confirmação do cliente pelo botão do lembrete de véspera
  clientResponse    String?   @map("client_response") @db.VarChar(20) // "confirmed" | "declined"
  clientRespondedAt DateTime? @map("client_responded_at")

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurrenceParent   Meeting?          @relation("MeetingRecurrence", fields: [recurrenceParentId], references: [id], onDelete: Cascade)
  recurrenceChildren Meeting[]         @relation("MeetingRecurrence")
  visibleTo          MeetingAudience[]
  reminders          MeetingReminder[]

  @@index([userId, date])
  @@index([recurrenceParentId])
  @@index([googleEventId])
  @@index([date, status])
  @@index([endDate, status])
  @@map("meetings")
}

/// Lembrete de reunião agendado no WhatsApp.
///
/// Nada nosso acorda para enviar: no momento em que a reunião é marcada, a
/// mensagem é entregue à fila da própria UAZAPI, com data e hora. `folderId` é
/// a campanha lá do outro lado — é por ele que o lembrete é cancelado quando a
/// reunião cai.
///
/// A linha aqui existe para saber o que foi agendado, o que apagar num
/// cancelamento e o que reconciliar caso o agendamento tenha falhado.
///
/// A unique [meetingId, kind] impede agendar o mesmo lembrete duas vezes.
model MeetingReminder {
  id           String   @id @default(uuid()) @db.Uuid
  meetingId    String   @map("meeting_id") @db.Uuid
  kind         String   @db.VarChar(20) // day_before | morning | hour_before | minutes_before
  scheduledFor DateTime @map("scheduled_for") // instante do disparo
  folderId     String?  @map("folder_id") @db.VarChar(64) // campanha na UAZAPI
  status       String   @default("pending") @db.VarChar(20) // pending | scheduled | failed | skipped
  destination  String?  @db.VarChar(255)
  detail       String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, kind])
  @@index([status, scheduledFor])
  @@map("meeting_reminders")
}

model MeetingAudience {
  meetingId String @map("meeting_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
  @@map("meeting_audience")
}

model BookingMagicLink {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  managerId     String    @map("manager_id") @db.Uuid
  createdById   String    @map("created_by") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  clientEmail   String?   @map("client_email") @db.VarChar(255)
  clientName    String    @map("client_name") @db.VarChar(255)
  clientPlan    String?   @map("client_plan") @db.VarChar(255)
  clientGroupId String    @map("client_group_id") @db.VarChar(255)
  expiresAt     DateTime  @map("expires_at")
  openedAt      DateTime? @map("opened_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  manager   User    @relation("BookingMagicLinkManager", fields: [managerId], references: [id], onDelete: Cascade)
  createdBy User    @relation("BookingMagicLinkCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([managerId])
  @@index([expiresAt, revokedAt])
  @@map("booking_magic_links")
}

// ─── Disparos (broadcast para grupos de WhatsApp) ──────────────────────
//
// O envio em si vive na fila da UAZAPI, nao aqui: uma chamada /sender/advanced
// registra todas as mensagens de uma vez e devolve um folder_id. Guardamos esse
// id para consultar o andamento (/sender/listmessages) e para cancelar
// (/sender/edit). Assim nenhuma funcao da Vercel fica viva esperando o disparo
// terminar — o intervalo entre mensagens e responsabilidade da UAZAPI.

model Broadcast {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  createdById   String?         @map("created_by_id") @db.Uuid
  name          String          @db.VarChar(255)
  status        BroadcastStatus @default(draft)
  delayMin      Int             @default(15) @map("delay_min")
  delayMax      Int             @default(30) @map("delay_max")
  scheduledFor  DateTime?       @map("scheduled_for")
  // folder_id devolvido pela UAZAPI. Sem ele nao ha como acompanhar nem cancelar.
  folderId      String?         @map("folder_id") @db.VarChar(255)
  totalTargets  Int             @default(0) @map("total_targets")
  totalMessages Int             @default(0) @map("total_messages")
  error         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy  User?                @relation("BroadcastCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  messages   BroadcastMessage[]
  recipients BroadcastRecipient[]

  @@index([companyId, createdAt])
  @@map("broadcasts")
}

model BroadcastMessage {
  id              String               @id @default(uuid()) @db.Uuid
  broadcastId     String               @map("broadcast_id") @db.Uuid
  position        Int
  type            BroadcastMessageType
  // Texto da mensagem ou legenda da midia. Guardado com as variaveis ainda
  // cruas ({{nome}}), para o relatorio mostrar o que foi escrito, nao o
  // resultado de um destinatario especifico.
  text            String?
  fileUrl         String?              @map("file_url")
  fileName        String?              @map("file_name") @db.VarChar(255)
  choices         String[]             @default([])
  selectableCount Int?                 @map("selectable_count")

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId, position])
  @@map("broadcast_messages")
}

model BroadcastRecipient {
  id          String  @id @default(uuid()) @db.Uuid
  broadcastId String  @map("broadcast_id") @db.Uuid
  clientId    String? @map("client_id") @db.Uuid
  // Snapshot: o cliente pode ser renomeado ou arquivado depois do disparo, e o
  // relatorio precisa continuar dizendo para quem foi na epoca.
  clientName  String  @map("client_name") @db.VarChar(255)
  groupId     String  @map("group_id") @db.VarChar(255)
  externalId  String? @map("external_id") @db.VarChar(50)

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([broadcastId, groupId])
  @@index([broadcastId])
  @@map("broadcast_recipients")
}
